generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  SERVED
  CANCELLED
  PAID
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  CLEANING
}

enum PaymentMethod {
  CASH
  CARD
  MTN_MOMO
  AIRTEL_MONEY
  MIXED
  CREDIT
}

enum PrinterType {
  KITCHEN
  BAR
  RECEIPT
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

// ─── SUPER ADMIN ────────────────────────────────────────────────────────────

model SuperAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts    SystemAlert[]
}

model Business {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String?
  address      String?
  country      String         @default("Rwanda")
  tin          String?
  logo         String?
  status       BusinessStatus @default(PENDING)
  isVerified   Boolean        @default(false)
  ownerId      String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner        User           @relation(fields: [ownerId], references: [id])
  subscription Subscription?
  loginLogs    LoginLog[]
  platformRevenue PlatformRevenue[]
}

model Subscription {
  id         String             @id @default(cuid())
  businessId String             @unique
  plan       SubscriptionPlan   @default(FREE)
  status     SubscriptionStatus @default(TRIAL)
  startDate  DateTime           @default(now())
  endDate    DateTime?
  amount     Float              @default(0)
  currency   String             @default("RWF")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  business   Business           @relation(fields: [businessId], references: [id])
  payments   SubscriptionPayment[]
}

model SubscriptionPayment {
  id             String   @id @default(cuid())
  subscriptionId String
  amount         Float
  method         String
  reference      String?
  paidAt         DateTime @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model LoginLog {
  id         String   @id @default(cuid())
  userId     String
  businessId String?
  ipAddress  String?
  userAgent  String?
  action     String   @default("LOGIN")
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  business   Business? @relation(fields: [businessId], references: [id])
}

model PlatformRevenue {
  id         String   @id @default(cuid())
  businessId String
  amount     Float
  type       String
  month      Int
  year       Int
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id])
}

model SystemAlert {
  id          String   @id @default(cuid())
  superAdminId String
  type        String
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  superAdmin  SuperAdmin @relation(fields: [superAdminId], references: [id])
}

model PlatformSettings {
  id                String  @id @default(cuid())
  maintenanceMode   Boolean @default(false)
  allowRegistration Boolean @default(true)
  trialDays         Int     @default(14)
  starterPrice      Float   @default(29000)
  professionalPrice Float   @default(79000)
  enterprisePrice   Float   @default(199000)
  supportEmail      String  @default("support@shms.rw")
  updatedAt         DateTime @updatedAt
}

// ─── EXISTING MODELS ────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  pin          String?
  role         UserRole      @default(CASHIER)
  isActive     Boolean       @default(true)
  businessId   String?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  activityLogs ActivityLog[]
  loginLogs    LoginLog[]
  businesses   Business[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  icon      String?
  color     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Printer {
  id        String      @id @default(cuid())
  name      String
  type      PrinterType
  ipAddress String?
  port      Int?
  usbPath   String?
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  products  Product[]
}

model Product {
  id         String           @id @default(cuid())
  name       String
  sku        String?          @unique
  barcode    String?
  image      String?
  categoryId String
  costPrice  Float            @default(0)
  sellPrice  Float
  vatRate    Float            @default(0)
  printerId  String?
  trackStock Boolean          @default(true)
  isActive   Boolean          @default(true)
  isFavorite Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  category   Category         @relation(fields: [categoryId], references: [id])
  printer    Printer?         @relation(fields: [printerId], references: [id])
  stock      Stock?
  orderItems OrderItem[]
  variants   ProductVariant[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String
  price     Float
  isActive  Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id])
}

model Stock {
  id          String          @id @default(cuid())
  productId   String          @unique
  quantity    Float           @default(0)
  minQuantity Float           @default(5)
  unit        String          @default("pcs")
  updatedAt   DateTime        @updatedAt
  product     Product         @relation(fields: [productId], references: [id])
  movements   StockMovement[]
}

model StockMovement {
  id        String   @id @default(cuid())
  stockId   String
  type      String
  quantity  Float
  reason    String?
  reference String?
  createdAt DateTime @default(now())
  stock     Stock    @relation(fields: [stockId], references: [id])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  balance   Float      @default(0)
  createdAt DateTime   @default(now())
  purchases Purchase[]
}

model Purchase {
  id         String         @id @default(cuid())
  supplierId String
  total      Float
  paid       Float          @default(0)
  notes      String?
  createdAt  DateTime       @default(now())
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  items      PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Float
  unitCost   Float
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
}

model Table {
  id        String      @id @default(cuid())
  number    String
  name      String?
  capacity  Int         @default(4)
  status    TableStatus @default(FREE)
  section   String?
  createdAt DateTime    @default(now())
  orders    Order[]
}

model Order {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  tableId       String?
  userId        String
  status        OrderStatus    @default(PENDING)
  notes         String?
  subtotal      Float          @default(0)
  vatAmount     Float          @default(0)
  discount      Float          @default(0)
  total         Float          @default(0)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  table         Table?         @relation(fields: [tableId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  items         OrderItem[]
  payments      Payment[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Float
  unitPrice Float
  notes     String?
  printed   Boolean @default(false)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  method    PaymentMethod
  amount    Float
  reference String?
  createdAt DateTime      @default(now())
  order     Order         @relation(fields: [orderId], references: [id])
}

model RoomCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  basePrice   Float
  rooms       Room[]
}

model Room {
  id           String        @id @default(cuid())
  number       String        @unique
  categoryId   String
  status       RoomStatus    @default(AVAILABLE)
  floor        Int?
  description  String?
  createdAt    DateTime      @default(now())
  category     RoomCategory  @relation(fields: [categoryId], references: [id])
  reservations Reservation[]
}

model Guest {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  idNumber     String?
  nationality  String?
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

model Reservation {
  id             String    @id @default(cuid())
  roomId         String
  guestId        String
  checkIn        DateTime
  checkOut       DateTime
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  adults         Int       @default(1)
  children       Int       @default(0)
  totalAmount    Float
  paid           Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  room           Room      @relation(fields: [roomId], references: [id])
  guest          Guest     @relation(fields: [guestId], references: [id])
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model BusinessSettings {
  id            String   @id @default(cuid())
  name          String
  address       String?
  phone         String?
  email         String?
  tin           String?
  logo          String?
  currency      String   @default("RWF")
  vatRate       Float    @default(18)
  receiptFooter String?
  updatedAt     DateTime @updatedAt
}
